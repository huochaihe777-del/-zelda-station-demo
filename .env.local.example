# 复制成 .env.local 然后填实际值（.env.local 不入 git）
# Railway 部署时把这些值填到 Railway dashboard → Variables

# ===== 火山方舟 embedding（真向量召回，必选）=====
ARK_EMBEDDING_API_KEY=
ARK_EMBEDDING_ENDPOINT=ep-20260425105526-7bkxt
ARK_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
ARK_EMBEDDING_BATCH_SIZE=64

# ===== DeepSeek 对话生成（gen3 模型友好存储，必选）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ===== 端口（Railway 自动注入 PORT，本地默认 5180）=====
# PORT=5180
